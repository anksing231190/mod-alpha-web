# ---------- Mod Alpha — LOCAL (your computer) ----------
# Copy to .env.local. Works as-is with Docker; for the non-Docker route edit DATABASE_URL.
APP_ENV=stage
PORT=8080
PUBLIC_APP_URL=http://localhost:8081
API_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8081
DATABASE_URL=postgres://modalpha:modalpha@localhost:5432/modalpha
JWT_SECRET=local-dev-secret-local-dev-secret-local-dev-secret
# Session rules: sign out after N minutes without activity, and N hours after sign-in (users / admins).
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS_USER=12
SESSION_MAX_HOURS_ADMIN=8
ADMIN_BOOTSTRAP_EMAIL=admin@modalpha.local
ADMIN_BOOTSTRAP_PASSWORD=Admin-password-123
ADMIN_BOOTSTRAP_MOBILE=+919900000001   # admins also confirm a code sent by SMS
LOG_LEVEL=info
# All external providers run as mocks locally (see docs/23_mocks_and_replacements.md).

# ---- GST tax invoice (printed on every invoice PDF). GSTIN and address are required in prod.
INVOICE_SELLER_NAME=Mod Alpha Ventures LLP
INVOICE_SELLER_ADDRESS=            # registered address; use " | " for a line break
INVOICE_SELLER_STATE_CODE=29       # GST state code of the registered office (29 = Karnataka)
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_PAN=
INVOICE_SELLER_LLPIN=
INVOICE_SEBI_REG=                  # e.g. Research Analyst INH000000000
INVOICE_SAC=997156                 # confirm the SAC with the company's CA
INVOICE_SUPPORT_EMAIL=support@modalpha.in
