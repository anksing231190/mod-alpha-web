# Copy to .env.stage on the stage server (same folder as docker-compose.yml). NEVER commit the real file.
# ---- infrastructure
# GitHub account that owns the images (ghcr.io/<owner>/mod-alpha-api)
GHCR_OWNER=anksing231190
# long random string:  openssl rand -base64 32
POSTGRES_PASSWORD=
# ---- address. Normal: leave these two empty (uses Caddyfile: stage.modalpha.in + api.stage.modalpha.in).
# Temporary (domain not ready): CADDYFILE=Caddyfile.temp and STAGE_HOST=<ip-with-dashes>.sslip.io, and set
# PUBLIC_APP_URL / API_PUBLIC_URL / CORS_ORIGINS below to https://<that host>, COOKIE_DOMAIN empty.
CADDYFILE=
STAGE_HOST=
# Website's API address. Empty = the one built into the image (https://api.stage.modalpha.in).
# Temporary mode: https://<ip-with-dashes>.sslip.io
WEB_API_BASE_URL=
# ---- app (see .env.stage.example in the repo root for every option)
APP_ENV=stage
PORT=8080
PUBLIC_APP_URL=https://stage.modalpha.in
API_PUBLIC_URL=https://api.stage.modalpha.in
CORS_ORIGINS=https://stage.modalpha.in
COOKIE_DOMAIN=.stage.modalpha.in
# openssl rand -base64 48
JWT_SECRET=
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS_USER=12
SESSION_MAX_HOURS_ADMIN=8
# first super admin (stage)
ADMIN_BOOTSTRAP_EMAIL=
# at least 12 characters; remove after first sign-in
ADMIN_BOOTSTRAP_PASSWORD=
# +91XXXXXXXXXX — admins confirm an SMS code (shown on screen while SMS is mocked)
ADMIN_BOOTSTRAP_MOBILE=
LOG_LEVEL=info
# ---- providers: mocks until each vendor's sandbox keys arrive (docs/23)
PAYMENT_PROVIDER=mock
KYC_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
WHATSAPP_PROVIDER=mock
AI_PROVIDER=mock
NAV_PROVIDER=mock
OAUTH_GOOGLE=mock
SUPPORT_PROVIDER=mock
# ---- GST invoice details (placeholders are fine on stage)
INVOICE_SELLER_NAME=Mod Alpha Ventures LLP
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_STATE_CODE=29
INVOICE_SELLER_GSTIN=
INVOICE_SAC=997156
INVOICE_SUPPORT_EMAIL=support@modalpha.in
# ---- backups (optional): s3://modalpha-backups-stage
BACKUP_S3_URI=
