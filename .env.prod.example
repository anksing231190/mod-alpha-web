# ---------- Mod Alpha API — PROD ----------
# Secrets must come from the secrets manager / CI environment, never from a committed file.
APP_ENV=prod
PORT=8080
PUBLIC_APP_URL=https://modalpha.in
API_PUBLIC_URL=https://api.modalpha.in
CORS_ORIGINS=https://modalpha.in,https://www.modalpha.in
DATABASE_URL=            # managed Postgres (RDS / Cloud SQL), TLS on
DATABASE_SSL=true
JWT_SECRET=              # 64+ random chars
COOKIE_DOMAIN=.modalpha.in
ADMIN_BOOTSTRAP_EMAIL=   # first super admin; remove after first deploy
ADMIN_BOOTSTRAP_PASSWORD=
LOG_LEVEL=info

# Prod refuses to start with mock payments/KYC/email/SMS.
# Temporary exception while a contract is pending (remove as soon as the real provider is live):
# ALLOW_MOCK_PROVIDERS=kyc
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
KYC_PROVIDER=digio
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_BASE_URL=https://api.digio.in
KYC_WEBHOOK_SECRET=
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM=Mod Alpha <no-reply@modalpha.in>
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_SMS_TEMPLATE_ID=
PUSH_PROVIDER=mock
WHATSAPP_PROVIDER=mock
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_INR=
NAV_PROVIDER=amfi
OAUTH_GOOGLE=google
GOOGLE_CLIENT_ID=
SUPPORT_PROVIDER=freshdesk
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
