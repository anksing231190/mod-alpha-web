# ---------- Mod Alpha API — PROD ----------
# Secrets must come from the secrets manager / CI environment, never from a committed file.
APP_ENV=prod
PORT=8080
PUBLIC_APP_URL=https://modalpha.in
API_PUBLIC_URL=https://api.modalpha.in
CORS_ORIGINS=https://modalpha.in,https://www.modalpha.in
DATABASE_URL=            # managed Postgres (RDS / Cloud SQL), TLS on
DATABASE_SSL=true
JWT_SECRET=              # 64+ random chars
# Session rules: sign out after N minutes without activity, and N hours after sign-in (users / admins).
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS_USER=12
SESSION_MAX_HOURS_ADMIN=8
COOKIE_DOMAIN=.modalpha.in
ADMIN_BOOTSTRAP_EMAIL=   # first super admin; remove after first deploy
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_MOBILE=   # required: admins sign in with email OTP + SMS OTP
LOG_LEVEL=info

# Prod refuses to start with mock payments/KYC/email/SMS.
# Temporary exception while a contract is pending (remove as soon as the real provider is live):
# ALLOW_MOCK_PROVIDERS=kyc
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
KYC_PROVIDER=digio
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_BASE_URL=https://api.digio.in
KYC_WEBHOOK_SECRET=
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM=Mod Alpha <no-reply@modalpha.in>
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_SMS_TEMPLATE_ID=
PUSH_PROVIDER=mock
WHATSAPP_PROVIDER=mock
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5   # low-cost model for short, data-grounded answers
AI_MONTHLY_BUDGET_INR=           # whole-app AI spend cap per month (₹); answers fall back to the free rule-based assistant when reached
NAV_PROVIDER=amfi
OAUTH_GOOGLE=google
GOOGLE_CLIENT_ID=
SUPPORT_PROVIDER=freshdesk
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# ---- GST tax invoice (printed on every invoice PDF). GSTIN and address are required in prod.
INVOICE_SELLER_NAME=Mod Alpha Ventures LLP
INVOICE_SELLER_ADDRESS=            # registered address; use " | " for a line break
INVOICE_SELLER_STATE_CODE=29       # GST state code of the registered office (29 = Karnataka)
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_PAN=
INVOICE_SELLER_LLPIN=
INVOICE_SEBI_REG=                  # e.g. Research Analyst INH000000000
INVOICE_SAC=997156                 # confirm the SAC with the company's CA
INVOICE_SUPPORT_EMAIL=support@modalpha.in
