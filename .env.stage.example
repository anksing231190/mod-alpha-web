# ---------- Mod Alpha API — STAGE ----------
APP_ENV=stage
PORT=8080
PUBLIC_APP_URL=https://stage.modalpha.in
API_PUBLIC_URL=https://api.stage.modalpha.in
CORS_ORIGINS=https://stage.modalpha.in
DATABASE_URL=postgres://modalpha:CHANGE_ME@stage-db:5432/modalpha
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-64-char-random-string-for-stage-environment-only
COOKIE_DOMAIN=.stage.modalpha.in
ADMIN_BOOTSTRAP_EMAIL=admin@modalpha.in
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password
ADMIN_BOOTSTRAP_MOBILE=   # admins sign in with email OTP + SMS OTP
LOG_LEVEL=info

# Providers — stage runs on mocks until each vendor is contracted (docs/23_mocks_and_replacements.md).
# Switch one to the real value and fill its credentials to test it on stage first.
PAYMENT_PROVIDER=mock      # razorpay  → RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET (test-mode keys)
KYC_PROVIDER=mock          # digio     → DIGIO_CLIENT_ID / DIGIO_CLIENT_SECRET / KYC_WEBHOOK_SECRET (sandbox)
EMAIL_PROVIDER=mock        # sendgrid  → SENDGRID_API_KEY
SMS_PROVIDER=mock          # msg91     → MSG91_AUTH_KEY / MSG91_SENDER_ID / MSG91_OTP_TEMPLATE_ID / MSG91_SMS_TEMPLATE_ID
PUSH_PROVIDER=mock         # fcm       → FCM_SERVER_KEY
WHATSAPP_PROVIDER=mock     # meta      → META_WA_TOKEN / META_WA_PHONE_ID
AI_PROVIDER=mock           # anthropic → ANTHROPIC_API_KEY
NAV_PROVIDER=mock          # amfi      (no key; public file)
OAUTH_GOOGLE=mock          # google    → GOOGLE_CLIENT_ID
SUPPORT_PROVIDER=mock      # freshdesk → FRESHDESK_DOMAIN / FRESHDESK_API_KEY
